{
  "name": "phurai-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "cd frontend && npx vite --host",
    "dev:backend": "node --watch --watch-path=backend/src backend/src/index.js",

    "clean-ports": "docker stop phurai-app phurai-app-local 2>/dev/null || true; for pid in $(lsof -t -i:5001 -i:5173 2>/dev/null); do kill -9 $pid 2>/dev/null || true; done",
    "dev:full": "npm run clean-ports && concurrently --kill-others \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "cd frontend && npx vite build",
    "lint": "eslint .",
    "preview": "cd frontend && npx vite preview --host",
    "db:init":       "node backend/src/run_master_schema.js",
    "db:init:prod":  "node backend/src/run_master_schema.js --confirm",
    "db:init:local": "node backend/src/run_master_schema.js --confirm --seed-full",
    "db:seed":       "node backend/scripts/inject_seed_to_sql.mjs",
    "migrate":       "node migrate.cjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.18.0",
    "mssql": "^12.5.5",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "nodemailer": "^9.0.1",
    "prop-types": "^15.8.1",
    "qrcode.react": "^4.2.0",
    "qs": "^6.15.2",
    "react": "^19.2.6",
    "react-date-range": "^2.0.1",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.30.4",
    "react-toastify": "^11.1.0",
    "recharts": "^3.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "kill-port": "^2.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.12"
  }
}