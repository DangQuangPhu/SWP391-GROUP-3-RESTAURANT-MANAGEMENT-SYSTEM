+export const analyzeDishTextWithGemini = async ({ textPrompt, menuList = [] }) => {
+    const modelsToTry = [
+        "gemini-1.5-flash",
+        "gemini-1.5-flash-latest",
+        "gemini-2.5-flash"
+    ];
+
+    const simplifiedMenu = menuList.map(item => ({
+        id: item.id,
+        name: item.name,
+        category: item.category || item.category_name || "General",
+        description: item.description || "",
+        price: item.price
+    }));
+
+    const systemPrompt = `You are Phūrai Restaurant's AI Executive Chef. Analyze the user's craving/text description and recommend dishes from Phūrai's active menu:
+${JSON.stringify(simplifiedMenu, null, 2)}
+
+USER'S CRAVING: "${textPrompt}"
+
+TASK & OUTPUT INSTRUCTIONS:
+1. Read the user's craving.
+2. Recommend 1 to 3 best matching dishes from the Phūrai menu list that satisfy this craving.
+3. Return JSON with:
+   - "matchedDishIds": array of dish IDs.
+   - "matchScores": object keyed by dish ID string with relevance score (0-100).
+   - "reasons": object keyed by dish ID string with a concise 1-sentence explanation of why it fits their craving.
+   - "isFood": always true.
+   - "detectedFoodName": the general food category or flavor they asked for (e.g., "Spicy Noodles").
+
+CRITICAL: Return ONLY raw, valid JSON. Do not include markdown code block backticks (\`\`\`json).`;
+
+    for (const modelName of modelsToTry) {
+        try {
+            const model = ai.getGenerativeModel({ 
+                model: modelName,
+                generationConfig: { responseMimeType: "application/json" }
+            });
+            const response = await model.generateContent(systemPrompt);
+            const responseText = response.response.text().trim();
+            const cleanJson = responseText.replace(/^```json\s*/i, '').replace(/\s*```$/i, '');
+            return JSON.parse(cleanJson);
+        } catch (error) {
+            console.warn(`Text AI search error with model ${modelName}:`, error.message || error);
+        }
+    }
+    throw new Error("Failed to process text search.");
+};
